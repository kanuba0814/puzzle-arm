def load_font(font_path, size):
    fallback_size = round(size * 1.3)
    return (
        pygame.font.Font(font_path, size)
        if font_path
        else pygame.font.Font(None, fallback_size)
    )


_OPAQUE_ALPHA_CACHE = {}
_XRGB8888_MASKS = (0x00FF0000, 0x0000FF00, 0x000000FF, 0)


def force_opaque_kms_framebuffer(surface) -> bool:
    """修正 SDL KMSDRM 将 XRGB 缓冲区注册为 ARGB 导致的全透明画面。"""
    if surface.get_bitsize() != 32 or surface.get_masks() != _XRGB8888_MASKS:
        return False

    framebuffer = memoryview(surface.get_view("0")).cast("B")
    alpha_bytes = framebuffer[3::4]
    pixel_count = len(alpha_bytes)
    opaque = _OPAQUE_ALPHA_CACHE.setdefault(pixel_count, b"\xff" * pixel_count)
    alpha_bytes[:] = opaque
    del alpha_bytes
    del framebuffer
    return True


def touch_event_to_mouse_event(event, screen_size):
    """将 SDL 归一化触摸坐标转换成现有控件使用的鼠标事件。"""
    event_types = {
        pygame.FINGERDOWN: pygame.MOUSEBUTTONDOWN,
        pygame.FINGERMOTION: pygame.MOUSEMOTION,
        pygame.FINGERUP: pygame.MOUSEBUTTONUP,
    }
    if event.type not in event_types:
        return event

    width, height = screen_size
    pos = (
        max(0, min(width - 1, math.floor(event.x * width))),
        max(0, min(height - 1, math.floor(event.y * height))),
    )
    attributes = {"pos": pos, "touch": True}
    if event.type == pygame.FINGERMOTION:
        attributes.update(
            {
                "rel": (round(event.dx * width), round(event.dy * height)),
                "buttons": (1, 0, 0),
            }
        )
    else:
        attributes["button"] = 1
    return pygame.event.Event(event_types[event.type], attributes)


_RGB565_MASKS = (0xF800, 0x07E0, 0x001F, 0)
_INPUT_EVENT = struct.Struct("llHHI")
_EV_SYN = 0
_EV_KEY = 1
_EV_ABS = 3
_SYN_REPORT = 0
_BTN_TOUCH = 330
_ABS_X = 0
_ABS_Y = 1
_ABS_MT_POSITION_X = 53
_ABS_MT_POSITION_Y = 54


def scale_evdev_axis(value, minimum, maximum, screen_extent):
    """把 evdev 绝对坐标映射并钳制到屏幕像素。"""
    if maximum <= minimum:
        raise ValueError("触摸轴范围无效")
    normalized = (value - minimum) / (maximum - minimum)
    return max(0, min(screen_extent - 1, round(normalized * (screen_extent - 1))))


def copy_surface_to_rgb565(source, target) -> memoryview:
    """用 pygame 的 C blitter 将界面转换为 Linux fb0 使用的 RGB565。"""
    target.blit(source, (0, 0))
    return memoryview(target.get_view("0")).cast("B")


class LinuxFramebuffer:
    """将 pygame 离屏 Surface 直接提交到 Raspberry Pi 的 RGB565 fb0。"""

    def __init__(self, device_path, size):
        self.device_path = device_path
        self.width, self.height = size
        sysfs = Path("/sys/class/graphics") / Path(device_path).name
        try:
            self.stride = int((sysfs / "stride").read_text().strip())
            bits_per_pixel = int(
                (sysfs / "bits_per_pixel").read_text().strip()
            )
        except (OSError, ValueError) as error:
            raise RuntimeError(f"无法读取 {device_path} framebuffer 参数") from error
        if bits_per_pixel != 16:
            raise RuntimeError(f"fb0 必须是 RGB565/16bpp，实际为 {bits_per_pixel}bpp")

        descriptor = os.open(device_path, os.O_RDWR)
        try:
            self.memory = mmap.mmap(descriptor, self.stride * self.height)
        finally:
            os.close(descriptor)
        self.rgb565 = pygame.Surface(size, depth=16, masks=_RGB565_MASKS)
        if self.rgb565.get_pitch() != self.stride:
            raise RuntimeError(
                f"framebuffer stride 不匹配: pygame={self.rgb565.get_pitch()}, "
                f"fb0={self.stride}"
            )

    @staticmethod
    def read_size(device_path):
        size_path = (
            Path("/sys/class/graphics") / Path(device_path).name / "virtual_size"
        )
        try:
            width_text, height_text = size_path.read_text().strip().split(",")
            return int(width_text), int(height_text)
        except (OSError, ValueError) as error:
            raise RuntimeError(f"无法读取 {device_path} 分辨率") from error

    def present(self, source):
        pixels = copy_surface_to_rgb565(source, self.rgb565)
        self.memory.seek(0)
        self.memory.write(pixels)
        del pixels

    def close(self):
        self.memory.flush()
        self.memory.close()


class EvdevTouchReader:
    """从 QDTECH MPI700 evdev 节点生成 pygame 鼠标事件。"""

    def __init__(self, screen_size, device_path=None):
        self.width, self.height = screen_size
        self.device_path = device_path or self._find_device()
        self.descriptor = os.open(self.device_path, os.O_RDONLY | os.O_NONBLOCK)
        self.x_range = self._read_axis_range(_ABS_X)
        self.y_range = self._read_axis_range(_ABS_Y)
        self.raw_x = self.x_range[0]
        self.raw_y = self.y_range[0]
        self.pressed = False
        self.reported_pressed = False
        self.last_pos = (0, 0)
        self.dirty = False
        self.pending = bytearray()

    @staticmethod
    def _find_device():
        for event_path in sorted(Path("/sys/class/input").glob("event*")):
            try:
                name = (event_path / "device/name").read_text().strip()
            except OSError:
                continue
            if "QDTECH" in name and "MPI700" in name:
                return f"/dev/input/{event_path.name}"
        raise RuntimeError("未找到 QDTECH MPI700 触摸屏 evdev 节点")

    def _read_axis_range(self, code):
        values = array.array("i", [0] * 6)
        fcntl.ioctl(self.descriptor, 0x80184540 + code, values, True)
        return values[1], values[2]

    def _position(self):
        return (
            scale_evdev_axis(self.raw_x, *self.x_range, self.width),
            scale_evdev_axis(self.raw_y, *self.y_range, self.height),
        )

    def _syn_event(self):
        pos = self._position()
        event = None
        if self.pressed and not self.reported_pressed:
            event = pygame.event.Event(
                pygame.MOUSEBUTTONDOWN, {"pos": pos, "button": 1, "touch": True}
            )
        elif not self.pressed and self.reported_pressed:
            event = pygame.event.Event(
                pygame.MOUSEBUTTONUP, {"pos": pos, "button": 1, "touch": True}
            )
        elif self.pressed and (self.dirty or pos != self.last_pos):
            rel = (pos[0] - self.last_pos[0], pos[1] - self.last_pos[1])
            event = pygame.event.Event(
                pygame.MOUSEMOTION,
                {"pos": pos, "rel": rel, "buttons": (1, 0, 0), "touch": True},
            )
        self.reported_pressed = self.pressed
        self.last_pos = pos
        self.dirty = False
        return event

    def poll(self):
        events = []
        while True:
            try:
                chunk = os.read(self.descriptor, _INPUT_EVENT.size * 64)
            except BlockingIOError:
                break
            if not chunk:
                break
            self.pending.extend(chunk)

        complete_length = len(self.pending) - len(self.pending) % _INPUT_EVENT.size
        for offset in range(0, complete_length, _INPUT_EVENT.size):
            _, _, event_type, code, value = _INPUT_EVENT.unpack_from(self.pending, offset)
            if event_type == _EV_ABS:
                if code in (_ABS_X, _ABS_MT_POSITION_X):
                    self.raw_x = value
                    self.dirty = True
                elif code in (_ABS_Y, _ABS_MT_POSITION_Y):
                    self.raw_y = value
                    self.dirty = True
            elif event_type == _EV_KEY and code == _BTN_TOUCH:
                self.pressed = bool(value)
                self.dirty = True
            elif event_type == _EV_SYN and code == _SYN_REPORT:
                event = self._syn_event()
                if event is not None:
                    events.append(event)
        if complete_length:
            self.pending = self.pending[complete_length:]
        return events

    def close(self):
        os.close(self.descriptor)


