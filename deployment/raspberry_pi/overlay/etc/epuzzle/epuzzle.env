# 比赛安全默认值：ACT、通用视觉和纹理不启用；继电器控制链路可用，但 PICK/PLACE 未实测且运动事故锁存在时不得自动动作。
EPUZZLE_CONFIG=/opt/epuzzle/configs/parameter_registry.yaml
EPUZZLE_WORKSPACE=/opt/epuzzle/workspace
EPUZZLE_ACT_ENABLED=0
EPUZZLE_GENERIC_VISION_ENABLED=0
EPUZZLE_TEXTURE_ENABLED=0
EPUZZLE_MAGNET_ENABLED=1
EPUZZLE_MAGNET_GPIO_CHIP=/dev/gpiochip0
EPUZZLE_MAGNET_GPIO_LINE=17
EPUZZLE_MAGNET_ACTIVE_HIGH=0
EPUZZLE_MAGNET_MAX_ON_SECONDS=10
EPUZZLE_ROBOT_PORT=/dev/epuzzle-arm
EPUZZLE_ROBOT_MOTION_LOCK=/etc/epuzzle/robot-motion.lock.json
# Sipeed MaixCAM 359f:2120 / c9c28f4513595968 的 UVC capture index 0。
EPUZZLE_CAMERA_DEVICE=/dev/epuzzle-camera
PYTHONPATH=/opt/epuzzle/workspace/src:/opt/epuzzle/workspace/src/robot_plugin/lerobot_robot_so101_5d:/usr/lib/python3/dist-packages
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2
PYTHONUNBUFFERED=1
