{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MotionGoal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal_id",
    "timestamp_ns",
    "frame",
    "position_mm",
    "pitch_deg",
    "yaw_deg",
    "phase",
    "speed_profile"
  ],
  "properties": {
    "goal_id": {
      "type": "string"
    },
    "timestamp_ns": {
      "type": "integer",
      "minimum": 0,
      "description": "time.monotonic_ns() clock domain; not Unix wall-clock time"
    },
    "frame": {
      "const": "robot_base_mm"
    },
    "position_mm": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "pitch_deg": {
      "type": "number"
    },
    "yaw_deg": {
      "type": "number"
    },
    "phase": {
      "enum": [
        "HOME",
        "SAFE",
        "PREGRASP",
        "PICK",
        "PREPLACE",
        "PLACE",
        "RECOVERY"
      ]
    },
    "speed_profile": {
      "enum": [
        "EMPTY_NORMAL",
        "EMPTY_SLOW",
        "HOLDING_SLOW",
        "LOCAL_POLICY"
      ]
    },
    "deadline_ns": {
      "type": "integer",
      "minimum": 0,
      "description": "Absolute time.monotonic_ns() deadline in the same clock domain as timestamp_ns"
    },
    "path_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "yaw_robot_deg",
        "pitch_robot_deg",
        "entry_xy_robot_mm",
        "vertical_distance_mm",
        "cartesian_step_mm",
        "yaw_tolerance_deg",
        "pitch_tolerance_deg",
        "wrist_limit_margin_deg",
        "max_entry_xy_error_mm",
        "recovery_to_target"
      ],
      "properties": {
        "yaw_robot_deg": {
          "type": "number"
        },
        "pitch_robot_deg": {
          "type": "number"
        },
        "entry_xy_robot_mm": {
          "type": "array",
          "prefixItems": [
            {"type": "number"},
            {"type": "number"}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "vertical_distance_mm": {
          "const": 30.0
        },
        "cartesian_step_mm": {
          "const": 5.0
        },
        "yaw_tolerance_deg": {
          "const": 5.0
        },
        "pitch_tolerance_deg": {
          "const": 5.0
        },
        "wrist_limit_margin_deg": {
          "const": 15.0
        },
        "max_entry_xy_error_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "recovery_to_target": {
          "type": "boolean"
        }
      }
    }
  }
}
